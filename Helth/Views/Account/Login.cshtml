@model Helth.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1 class="auth-title">تسجيل الدخول</h1>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
            <span asp-validation-for="Username" class="field-validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-validation"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">دخول</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
